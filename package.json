{
  "name": "multiple-choice-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/server.mjs",
    "dev:local": "node tools/server.mjs --local",
    "build": "node tools/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests tools",
    "typecheck": "tsc",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tools/test-local-browser.mjs && node tests/shared-browser.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "playwright": "^1.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
